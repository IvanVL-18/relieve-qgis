# Copia este archivo como .env y llénalo (el .env no se versiona)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=RelieveQGIS
DB_USERNAME=postgres
DB_PASSWORD=

# Nombre del servicio de PostgreSQL que usan QGIS y los scripts
# (se escribe en %APPDATA%\postgresql\.pg_service.conf al correr la fase 0)
PG_SERVICE=relieveqgis

# Datos crudos ya descargados por el proyecto web (carpeta data-src de RelieveHidalgo)
WEB_DATA=C:\ruta\a\RelieveHidalgo\data-src
